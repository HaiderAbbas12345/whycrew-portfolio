# Example environment variables
# Copy this file to .env.local and fill in your actual values

# MongoDB Connection String (get from MongoDB Atlas or your MongoDB instance)
NEXT_APP_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/whycrew-portfolio?retryWrites=true&w=majority

# Resend API Key (get from https://resend.com)
RESEND_API_KEY=your_resend_api_key_here

# From email address (must be a verified domain in Resend)
FROM_EMAIL="WhyCrew Contact <noreply@yourdomain.com>"

# Next.js public URL
NEXT_PUBLIC_URL=https://whycrew.com