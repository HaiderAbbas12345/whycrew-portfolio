# ---------------------------------------------------------------------------
# Contact form delivery
#
# These use the SAME variable names as the previous whycrew-portfolio site, so
# the values already set in Vercel carry over with no changes needed.
#
# The form needs EITHER the email pair OR the webhook. With neither set,
# /api/contact returns 503 and the UI falls back to a prefilled mailto: rather
# than silently dropping the lead.
# ---------------------------------------------------------------------------

# --- Email (primary) -------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Where enquiries land. Comma-separate for multiple recipients.
LEAD_TO_EMAIL="hello@whycrew.com"

# Sender. MUST be on a domain verified in Resend (whycrew.com already is).
LEAD_FROM_EMAIL="WhyCrew <hello@whycrew.com>"

# Send the submitter a "we got it, an engineer replies within 1 business day"
# confirmation. Requires the verified domain above.
CONTACT_AUTOREPLY="false"

# --- Webhook (optional mirror) --------------------------------------------
# Slack/Teams incoming webhook, Zapier/Make/n8n hook, or your CRM endpoint.
# Runs alongside email; a failure in one does not block the other.
# LEAD_WEBHOOK_URL="https://hooks.slack.com/services/..."

# --- Public (inlined at build time) ---------------------------------------
# Every "Book a call" CTA points here. Unset, they fall back to /contact.
NEXT_PUBLIC_BOOKING_URL="https://cal.com/whycrew/20min"

# Carries Search Console ownership over from the previous deployment.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_FOUNDER_LINKEDIN=""

# ---------------------------------------------------------------------------
# CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL / CONTACT_WEBHOOK_URL are also accepted
# as aliases for LEAD_* if you prefer the newer names on a fresh setup.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Admin lead dashboard  (/admin)
#
# Leads submitted through the contact form are written to a database and
# managed at /admin — pipeline stage, notes, search. This is independent of
# email: if the database is configured, a lead is captured even when mail is
# not.
# ---------------------------------------------------------------------------

# Sign-in is one user, stored in MongoDB with a salted scrypt hash of the
# password — the password itself is never written anywhere. Create it with:
#
#   npm run seed:admin
#
# Re-running that command rotates the password. It reads the two variables
# below, or takes --username / --password, or prompts if neither is given.
#
# ADMIN_USERNAME defaults to "admin" when unset.
ADMIN_USERNAME="admin"

# SEED INPUT ONLY. Once seed:admin has run, the user exists in the database and
# this can be deleted from the environment — leaving it set keeps a plaintext
# password around for no benefit.
ADMIN_PASSWORD=""

# Signs the session cookie. Required once ADMIN_PASSWORD is removed (it falls
# back to ADMIN_PASSWORD only so a half-finished setup still works).
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# --- MongoDB (the production store) ---------------------------------------
#
# Set this and leads go to MongoDB; it takes precedence over LEADS_DB_* below.
# This is what to use on Vercel — the filesystem there is ephemeral, so a file
# database is wiped on every deploy and is not shared between instances.
#
# Atlas connection string, from Database → Connect → Drivers. Keep the
# retryWrites/w=majority query string it gives you, and remember to
# URL-encode any special characters in the password.
#
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# Atlas also needs the deploying host allowed under Network Access. Vercel's
# egress IPs are not fixed, so that generally means 0.0.0.0/0 plus a strong
# database password, or a private endpoint on a paid tier.
MONGODB_URI=""

# Database name inside the cluster. Defaults to "whycrew" if unset. The
# collections (leads, lead_notes, counters) and their indexes are created
# automatically on first write.
MONGODB_DB="whycrew"

# --- SQLite (used only when MONGODB_URI is empty) --------------------------
#
#   unset            → a local file at .data/leads.db (node:sqlite, built in).
#                      Zero setup — correct for local dev and self-hosted.
#   https://…        → Turso, libSQL over HTTP. An alternative to Mongo for
#                      serverless; the same SQLite, reachable over the network.
#
# Create one with:  turso db create whycrew-leads
#                   turso db show whycrew-leads --url
#                   turso db tokens create whycrew-leads
LEADS_DB_URL=""
LEADS_DB_TOKEN=""
