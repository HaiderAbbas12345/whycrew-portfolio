# Copy to .env.local and fill in. Nothing here is required for the site to build,
# but until at least one lead-delivery channel is set, /api/contact returns 503 in
# production and the form shows its "email us instead" fallback.

# ── Lead delivery ────────────────────────────────────────────────────────────
# Option A — post every lead to a CRM/automation webhook (Zoho Flow, Make, n8n,
# Zapier). This is the recommended primary channel: it lands the lead in the CRM
# where lead scoring and nurture sequences can pick it up.
LEAD_WEBHOOK_URL=

# Option B — email the lead via Resend (https://resend.com). Both the API key and
# a verified sending domain address are required for this channel to activate.
RESEND_API_KEY=
LEAD_FROM_EMAIL=website@whycrew.com
LEAD_TO_EMAIL=hello@whycrew.com

# ── Booking ──────────────────────────────────────────────────────────────────
# A Zoho Bookings or Calendly link. When set, every "Book a call" button goes
# straight to the calendar instead of the contact form. Leave empty to route all
# CTAs to /contact.
NEXT_PUBLIC_BOOKING_URL=

# ── Social ───────────────────────────────────────────────────────────────────
# Once the LinkedIn company page exists, set it here. It shows in the footer and
# is emitted as sameAs in the Organization structured data, which is one of the
# cross-source signals AI answer engines use to corroborate the brand.
NEXT_PUBLIC_LINKEDIN_URL=

# Yasir's personal LinkedIn profile. Shows as a link on the /about leadership
# card and as sameAs in the Person schema — the corroboration signal that ties
# the named founder to a verifiable identity off-site.
NEXT_PUBLIC_FOUNDER_LINKEDIN=

# ── Verification ─────────────────────────────────────────────────────────────
# From Search Console → Settings → Ownership verification → HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
